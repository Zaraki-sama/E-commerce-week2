<script setup>
  import Header from "./Header.vue";
  import { ref, computed, onMounted } from "vue";
  import { useRoute, useRouter } from "vue-router";
  // import { getProductById } from "../data/products.js"; // COMMENTED OUT - using API-only flow
  import { useCart } from "../stores/cart.js";

  const route = useRoute();
  const router = useRouter();
  const { addToCart } = useCart();

  const sizes = ["S", "M", "L"];
  const selectedSize = ref(null);
  const colors = ["White", "Red", "Black"];
  const selectedColor = ref(null);
  const quantity = ref(1);
  const isLoading = ref(true);

  // Get the current product based on the route parameter - COMMENTED OUT
  // const currentProduct = computed(() => {
  //   const productId = parseInt(route.params.id);
  //   const product = getProductById(productId);

  //   // If product not found, redirect to home
  //   if (!product) {
  //     router.push("/");
  //     return null;
  //   }

  //   return product;
  // });

  // Handle loading state
  onMounted(() => {
    setTimeout(() => {
      isLoading.value = false;
    }, 300);
  });

  // Handle invalid product ID
  if (!currentProduct.value) {
    router.push("/");
  }

  // Add to cart function
  const handleAddToCart = () => {
    if (!selectedColor.value || !selectedSize.value) {
      alert("Please select both color and size before adding to cart");
      return;
    }

    addToCart(
      currentProduct.value,
      selectedColor.value,
      selectedSize.value,
      quantity.value
    );
    alert("Item added to cart successfully!");
  };

  // Quantity controls
  const increaseQuantity = () => {
    quantity.value++;
  };

  const decreaseQuantity = () => {
    if (quantity.value > 1) {
      quantity.value--;
    }
  };
</script>

<template>
  <Header />
  <section class="container mx-auto p-6">
    <!-- Loading State -->
    <div
      v-if="isLoading"
      class="flex justify-center items-center min-h-[400px]"
    >
      <div
        class="animate-spin rounded-full h-12 w-12 border-b-2 border-orange-500"
      ></div>
    </div>

    <!-- Product Details -->
    <div
      v-else-if="currentProduct"
      class="flex items-start gap-[36px] max-md:flex-col"
    >
      <!-- LEFT: Product Image -->
      <div class="flex-1">
        <img :src="currentProduct.image" :alt="currentProduct.title" />
      </div>

      <!-- RIGHT: Product Details -->
      <div class="flex-1">
        <h1 class="mb-2 font-semibold text-[24px] text-[#565656]">
          {{ currentProduct.title }}
        </h1>
        <p class="currency font-bold text-[24px] text-primary-600">
          Rs {{ currentProduct.price.toLocaleString() }}
        </p>
        <p class="mt-2 text-sm text-dim">Shipping is calculated at checkout</p>
        <p class="mt-3 mb-3 font-semibold font-base text-gray-600">
          Choose Variant
        </p>

        <div class="flex flex-wrap gap-2">
          <button
            v-for="color in colors"
            :key="color"
            @click="selectedColor = color"
            class="flex justify-center items-center cursor-pointer py-1 px-6 rounded-[4px] border text-base font-medium border-primary-500"
            :class="
              selectedColor === color
                ? 'border-orange-500'
                : 'border-primary-500 '
            "
          >
            <p class="text-center font-medium text-gray-700">{{ color }}</p>
          </button>
        </div>

        <p class="mt-3 mb-3 font-semibold font-base text-gray-600">
          Choose Size
        </p>

        <div class="flex flex-wrap mb-3 gap-2">
          <button
            v-for="size in sizes"
            :key="size"
            @click="selectedSize = size"
            class="flex justify-center items-center cursor-pointer py-1 px-6 rounded-[4px] border text-base font-medium transition-colors"
            :class="
              selectedSize === size
                ? 'border-orange-500'
                : 'border-primary-500 hover:bg-gray-50'
            "
          >
            <p class="text-center font-medium text-gray-700">{{ size }}</p>
          </button>
        </div>
        <div class="mt-[28px] flex gap-[6px]">
          <button
            @click="decreaseQuantity"
            class="btn-secondary border-gray-200 hover:bg-gray-50 h-[55px] w-[55px] p-0"
          >
            -
          </button>
          <div
            class="btn-secondary cursor-auto border-gray-200 hover:bg-gray-50 text-black text-[18px] w-[64px]"
          >
            {{ quantity }}
          </div>
          <button
            @click="increaseQuantity"
            class="btn-secondary border-gray-200 hover:bg-gray-50 h-[55px] w-[55px] p-0"
          >
            +
          </button>

          <button
            @click="handleAddToCart"
            class="w-fit px-6 py-3 transition rounded-md border border-transparent bg-[#ff922b] px-6 py-3 text-base font-medium text-white shadow-xs hover:bg-[#fd7e14] h-[55px] inline-flex items-center justify-center"
          >
            ADD TO CART
          </button>
        </div>
        <hr class="mt-10 my-4 border-gray-300" />
        <div><p class="font-semibold text-[16px]">Description</p></div>
        <div class="mt-5 overflow-wrap: break-word text-justify">
          <p>
            {{ currentProduct.description }}
          </p>
        </div>
        <div class="mt-5 break-words">
          <ul class="list-disc pl-5">
            <li v-for="feature in currentProduct.features" :key="feature">
              <strong>{{ feature.split(" ").slice(0, -1).join(" ") }}</strong>
              {{ feature.split(" ").slice(-1)[0] }}
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Error State -->
    <div v-else class="flex justify-center items-center min-h-[400px]">
      <div class="text-center">
        <h2 class="text-2xl font-semibold text-gray-600 mb-4">
          Product Not Found
        </h2>
        <p class="text-gray-500 mb-6">
          The product you're looking for doesn't exist.
        </p>
        <RouterLink
          to="/"
          class="inline-block px-6 py-3 bg-orange-500 text-white rounded-md hover:bg-orange-600 transition-colors"
        >
          Back to Home
        </RouterLink>
      </div>
    </div>
  </section>
</template>

<style scoped>
  .btn-secondary {
    cursor: pointer;
    border-style: var(--tw-border-style);
    border-width: 1px;
    border-color: var(--color-primary-500);
    padding-inline: calc(var(--spacing) * 6);
    padding-block: calc(var(--spacing) * 2);
    --tw-font-weight: var(--font-weight-semibold);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary-500);
    border-radius: 4px;
    justify-content: center;
    align-items: center;
    display: flex;
  }
</style>
